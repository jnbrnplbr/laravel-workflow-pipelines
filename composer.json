{
    "name": "jnbrnplbr/laravel-workflow-pipelines",
    "description": "Configurable approval workflows for Laravel applications.",
    "readme": "README.md",
    "keywords": [
        "laravel",
        "workflow",
        "approval"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.0",
        "spatie/laravel-permission": "^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Jnbrnplbr\\WorkflowPipelines\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jnbrnplbr\\WorkflowPipelines\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --no-progress",
        "format": "pint",
        "format:check": "pint --test",
        "check": [
            "@test",
            "@analyse",
            "@format:check"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jnbrnplbr\\WorkflowPipelines\\WorkflowPipelinesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
